{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "p3_matrix",
  "position": {
    "x": 20,
    "y": 60,
    "z": 3000,
    "height": 330,
    "width": 780,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_tier"
                    }
                  },
                  "Property": "card_tier"
                }
              },
              "queryRef": "dim_tier.card_tier",
              "nativeQueryRef": "card_tier",
              "displayName": "Card tier",
              "active": true
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_tenure"
                    }
                  },
                  "Property": "tenure_band"
                }
              },
              "queryRef": "dim_tenure.tenure_band",
              "nativeQueryRef": "tenure_band",
              "displayName": "Tenure band",
              "active": true
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Heatmap Label"
                }
              },
              "queryRef": "_Measures.Heatmap Label",
              "nativeQueryRef": "Heatmap Label"
            }
          ]
        }
      }
    },
    "objects": {
      "values": [
        {
          "properties": {
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "10.0D"
                }
              }
            },
            "wordWrap": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        },
        {
          "properties": {
            "backColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "_Measures"
                        }
                      },
                      "Property": "Heatmap Colour"
                    }
                  }
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "_Measures"
                        }
                      },
                      "Property": "Heatmap Font Colour"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "_Measures.Heatmap Label"
          }
        }
      ],
      "subTotals": [
        {
          "properties": {
            "rowSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "columnSubtotals": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "grid": [
        {
          "properties": {
            "rowPadding": {
              "expr": {
                "Literal": {
                  "Value": "12L"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Title Heatmap"
                }
              }
            },
            "titleWrap": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11.0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
