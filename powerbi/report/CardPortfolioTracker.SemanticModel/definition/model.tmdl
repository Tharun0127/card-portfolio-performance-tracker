model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fact_customer_quarter", "dim_customer", "dim_tier", "dim_tenure", "dim_scenario", "dim_bridge_step"]

ref table _Measures
ref table fact_customer_quarter
ref table dim_customer
ref table dim_tier
ref table dim_tenure
ref table dim_scenario
ref table dim_bridge_step

ref expression DataFolder
