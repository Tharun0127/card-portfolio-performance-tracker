	partition fact_customer_quarter = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_customer_quarter.csv"), [Delimiter = ",", Columns = 8, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario_key", Int64.Type}, {"customer_id", Int64.Type}, {"tier_key", Int64.Type}, {"tenure_key", Int64.Type}, {"quarter", type text}, {"is_active", Int64.Type}, {"txn_count", type number}, {"spend", type number}}, "en-US")
				in
